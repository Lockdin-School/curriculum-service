# Application
PORT=8080
RUST_LOG=info

# PostgreSQL Database
POSTGRES_USER=lockdin
POSTGRES_PASSWORD=lockdin_password
POSTGRES_DB=lockdin_school
POSTGRES_PORT=5433

# inside the server container
DATABASE_URL_INTERNAL=postgresql://lockdin:lockdin_password@postgresdb:5433/lockdin_school

# postgresql://postgres:mysecretpassword@db:5433/mydb
DATABASE_URL=postgresql://lockdin:lockdin_password@localhost:5433/lockdin_school
#POSTGRES_HOST_AUTH_METHOD=trust

# Redis
REDIS_PORT=6379
REDIS_URL=redis://host.docker.internal:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key-here
